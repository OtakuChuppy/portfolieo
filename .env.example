# Environment files — the Firebase backend needs no env vars
# (its public web config lives in src/firebase.js and is bundled at build time).
# Only optional extras go here:

# Optional: tracking (GA4)
# VITE_GA_ID=G-XXXXXXXXXX

# Optional: Stripe publishable keys (safe in frontend code)
VITE_STRIPE_PUBLISHABLE_KEY=sb_publishable_xxx
VITE_STRIPE_PUBLISHABLE_KEY_2=sb_publishable_xxx

